NODE_ENV=development
PORT=5000
CORS_ORIGINS="http://localhost:5173"

DATABASE=mongodb+srv://username:password@cluster.mongodb.net/myFirstDatabase?retryWrites=true&w=majority
DATABASE_PASSWORD=yourpassword
JWT_SECRET=yourjwtsecret
JWT_EXPIRES_IN=90d
JWT_COOKIE_EXPIRES=60
SESSION_SECRET=yoursessionsecret

# URLs for linking frontend/backends in redirects or emails
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# OAuth callback overrides (set to your deployed Railway URL)
GOOGLE_CALLBACK_URL=
FACEBOOK_CALLBACK_URL=
LINKEDIN_CALLBACK_URL=

# OAuth provider keys
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
LINKEDIN_KEY=
LINKEDIN_SECRET=
